diff --git i/crates/gpui_windows/src/gpui_windows.rs w/crates/gpui_windows/src/gpui_windows.rs
index e7a45a034d..fc5af3d1e1 100644
--- i/crates/gpui_windows/src/gpui_windows.rs
+++ w/crates/gpui_windows/src/gpui_windows.rs
@@ -1,5 +1,123 @@
 #![cfg(target_os = "windows")]
 
+/// Tachyon startup experiment: `gpui-trace <label> at=<ms since process
+/// creation> took=<ms>` lines on stderr. Not for upstream.
+pub(crate) mod trace {
+    use std::time::Instant;
+    use windows::Win32::Foundation::FILETIME;
+    use windows::Win32::System::SystemInformation::GetSystemTimePreciseAsFileTime;
+    use windows::Win32::System::Threading::{GetCurrentProcess, GetProcessTimes};
+
+    fn ticks(t: FILETIME) -> u64 {
+        (u64::from(t.dwHighDateTime) << 32) | u64::from(t.dwLowDateTime)
+    }
+
+    pub(crate) fn since_process_start_ms() -> f64 {
+        let mut created = FILETIME::default();
+        let (mut exit, mut kernel, mut user) =
+            (FILETIME::default(), FILETIME::default(), FILETIME::default());
+        unsafe {
+            if GetProcessTimes(GetCurrentProcess(), &mut created, &mut exit, &mut kernel, &mut user)
+                .is_err()
+            {
+                return -1.0;
+            }
+            let now = GetSystemTimePreciseAsFileTime();
+            ticks(now).saturating_sub(ticks(created)) as f64 / 10_000.0
+        }
+    }
+
+    pub(crate) fn span<T>(label: &str, f: impl FnOnce() -> T) -> T {
+        let at = since_process_start_ms();
+        let start = Instant::now();
+        let result = f();
+        eprintln!(
+            "gpui-trace {label} at={at:.1} took={:.2}",
+            start.elapsed().as_secs_f64() * 1000.0
+        );
+        result
+    }
+
+    pub(crate) fn note(line: &str) {
+        eprintln!("gpui-trace {line} at={:.1}", since_process_start_ms());
+    }
+
+    thread_local! {
+        static MESSAGES_UNTIL: std::cell::Cell<Option<Instant>> = const { std::cell::Cell::new(None) };
+        static DEPTH: std::cell::Cell<u32> = const { std::cell::Cell::new(0) };
+    }
+
+    /// Trace every window message handled on this thread for the next 3 s.
+    pub(crate) fn trace_messages_for_a_while() {
+        MESSAGES_UNTIL.with(|until| until.set(Some(Instant::now() + std::time::Duration::from_secs(3))));
+    }
+
+    /// Runs one window-procedure call, printing it if it took 0.3 ms or more
+    /// while message tracing is on. Nested calls (messages sent while handling
+    /// another) print with a higher depth; their time is included in the outer.
+    pub(crate) fn message<T>(msg: u32, f: impl FnOnce() -> T) -> T {
+        let active = MESSAGES_UNTIL.with(|until| until.get().is_some_and(|t| Instant::now() < t));
+        if !active {
+            return f();
+        }
+        let depth = DEPTH.with(|d| {
+            let depth = d.get();
+            d.set(depth + 1);
+            depth
+        });
+        let at = since_process_start_ms();
+        let start = Instant::now();
+        let result = f();
+        let took = start.elapsed().as_secs_f64() * 1000.0;
+        DEPTH.with(|d| d.set(depth));
+        if took >= 0.3 {
+            eprintln!(
+                "gpui-trace msg {} {:#06x} depth={depth} at={at:.1} took={took:.2}",
+                message_name(msg),
+                msg
+            );
+        }
+        result
+    }
+
+    fn message_name(msg: u32) -> &'static str {
+        match msg {
+            0x0001 => "WM_CREATE",
+            0x0003 => "WM_MOVE",
+            0x0005 => "WM_SIZE",
+            0x0006 => "WM_ACTIVATE",
+            0x0007 => "WM_SETFOCUS",
+            0x0008 => "WM_KILLFOCUS",
+            0x000C => "WM_SETTEXT",
+            0x000F => "WM_PAINT",
+            0x0014 => "WM_ERASEBKGND",
+            0x0018 => "WM_SHOWWINDOW",
+            0x001C => "WM_ACTIVATEAPP",
+            0x0020 => "WM_SETCURSOR",
+            0x0024 => "WM_GETMINMAXINFO",
+            0x003D => "WM_GETOBJECT",
+            0x0046 => "WM_WINDOWPOSCHANGING",
+            0x0047 => "WM_WINDOWPOSCHANGED",
+            0x007C => "WM_STYLECHANGING",
+            0x007D => "WM_STYLECHANGED",
+            0x007F => "WM_GETICON",
+            0x0081 => "WM_NCCREATE",
+            0x0083 => "WM_NCCALCSIZE",
+            0x0084 => "WM_NCHITTEST",
+            0x0085 => "WM_NCPAINT",
+            0x0086 => "WM_NCACTIVATE",
+            0x0281 => "WM_IME_SETCONTEXT",
+            0x0282 => "WM_IME_NOTIFY",
+            0x0288 => "WM_IME_REQUEST",
+            0x02E0 => "WM_DPICHANGED",
+            0x031F => "WM_DWMNCRENDERINGCHANGED",
+            0x0320 => "WM_DWMCOLORIZATIONCOLORCHANGED",
+            _ if msg >= 0x0400 => "WM_USER+",
+            _ => "WM_other",
+        }
+    }
+}
+
 mod clipboard;
 mod destination_list;
 mod dialog;
